# Copia este archivo a .env.local (vercel dev) y pon los valores en
# Vercel > Project > Settings > Environment Variables. Nunca subas el .env.

# DONKI se lee de https://ccmc.gsfc.nasa.gov/DONKI-API/get/ y NO necesita llave.
# NASA_API_KEY es opcional: solo se usa si CCMC falla (respaldo en api.nasa.gov).
NASA_API_KEY=
# DONKI_URL=https://ccmc.gsfc.nasa.gov/DONKI-API/get/

# RadLab / CRaTER: no necesita llave. Opcional: cambiar la ventana de datos (AAAA-MM-DD)
# o poner una URL completa de la API de RadLab (https://visualization.osdr.nasa.gov/radlab/api/).
RADLAB_DESDE=2024-05-01
RADLAB_HASTA=2024-06-15
RADLAB_URL=

# NASA OSDR: no necesita llave. Opcional: URL de búsqueda propia.
OSDR_URL=

# Supabase (solo para el modo Salón y el panel del maestro).
SUPABASE_URL=
# La publishable key (empieza con sb_publishable_). El juego la lee en /api/config: es pública, la RLS protege los datos.
SUPABASE_ANON_KEY=
# La service role key solo va en la función crear-alumno de Supabase, nunca en el navegador.
SUPABASE_SERVICE_ROLE_KEY=
DOMINIO_ALUMNOS=alumnos.g-nosis.local
