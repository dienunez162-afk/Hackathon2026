# Copia este archivo a .env.local (vercel dev) y pon los valores en
# Vercel > Project > Settings > Environment Variables. Nunca subas el .env.

# NASA Open APIs (DONKI). Pide una llave gratis en https://api.nasa.gov
# Sin llave se usa DEMO_KEY, que tiene un límite muy bajo de peticiones.
NASA_API_KEY=

# RadLab / CRaTER: URL del servicio que devuelve la dosis de radiación.
# Mientras esté vacía, /api/radlab responde 501 y el juego usa datos de muestra.
RADLAB_URL=
RADLAB_API_KEY=

# NASA OSDR (Open Science Data Repository): URL de la consulta que usaremos
# (por ejemplo, estudios de plantas en el espacio para el invernadero).
OSDR_URL=

# Supabase (solo para el modo Salón y el panel del maestro).
SUPABASE_URL=
SUPABASE_ANON_KEY=
# La service role key solo va en la función crear-alumno de Supabase, nunca en el navegador.
SUPABASE_SERVICE_ROLE_KEY=
DOMINIO_ALUMNOS=alumnos.g-nosis.local
